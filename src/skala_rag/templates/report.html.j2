<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <style>
    body { max-width: 860px; margin: 40px auto; padding: 0 24px; color: #1f2933; background: #fff; font: 15px/1.85 "Pretendard", -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Noto Sans KR", "Malgun Gothic", sans-serif; }
    h1, h2, th, caption { font-weight: 600; }
    header { text-align: center; border-bottom: 2px solid #1f2933; padding-bottom: 10px; }
    header h1 { font-size: 1.6rem; margin: 0 0 4px; }
    header .date { color: #5b6672; font-size: 0.85rem; margin: 0; }
    h1 { margin-top: 40px; font-size: 1.3rem; }
    h2 { margin-top: 26px; font-size: 1.08rem; }
    p { overflow-wrap: anywhere; text-align: justify; }
    section.small p { font-size: 0.82rem; line-height: 1.5; text-align: left; }
    table { border-collapse: collapse; width: 100%; font-size: 0.82rem; margin: 6px 0 16px; border-top: 2px solid #1f2933; border-bottom: 2px solid #1f2933; }
    caption { caption-side: top; text-align: left; font-size: 0.85rem; padding: 6px 0 4px; }
    th, td { border-bottom: 1px solid #d5dbe1; padding: 5px 8px; vertical-align: top; text-align: left; }
    th { background: #f3f5f7; border-bottom: 1px solid #1f2933; }
    footer { margin-top: 36px; padding-top: 8px; border-top: 1px solid #d5dbe1; color: #7b8794; font-size: 0.75rem; }
    @media print { body { max-width: none; margin: 0; } h1, h2 { break-after: avoid; } p, tr { break-inside: avoid; } }
  </style>
</head>
<body>
<header>
  <h1>{{ title }}</h1>
  {% if as_of %}<p class="date">기준일 {{ as_of }}</p>{% endif %}
</header>
{% for section in sections %}
  <section id="section-{{ loop.index0 }}"{% if section.heading in ("부록. 근거 목록", "REFERENCE") %} class="small"{% endif %}>
    {% if section.level == 1 %}<h1>{{ section.heading }}</h1>{% else %}<h2>{{ section.heading }}</h2>{% endif %}
    {% for paragraph in section.paragraphs %}<p>{{ paragraph | cite | urlize(target="_blank", rel="noopener noreferrer") }}</p>{% endfor %}
    {% if section.table and section.table.rows %}
    <table>
      {% if captions and captions.get(loop.index0) %}<caption>{{ captions[loop.index0] }}</caption>{% endif %}
      <thead><tr>{% for column in section.table.columns %}<th>{{ column }}</th>{% endfor %}</tr></thead>
      <tbody>{% for row in section.table.rows %}<tr>{% for cell in row %}<td>{{ cell | cite | urlize(target="_blank", rel="noopener noreferrer") }}</td>{% endfor %}</tr>{% endfor %}</tbody>
    </table>
    {% endif %}
  </section>
{% endfor %}
{% if meta %}<footer>생성 정보: {{ meta }}</footer>{% endif %}
</body>
</html>
